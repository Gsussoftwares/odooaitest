<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tally_voucher_map_list" model="ir.ui.view">
        <field name="name">tally.voucher.map.list</field>
        <field name="model">tally.voucher.map</field>
        <field name="arch" type="xml">
            <list string="Tally Voucher Type Mapping" editable="bottom">
                <field name="move_type" string="Odoo Document Type"/>
                <field name="tally_voucher_type" string="Tally Voucher Type"/>
                <field name="tally_persistedview" string="Tally View"/>
            </list>
        </field>
    </record>

    <record id="view_tally_voucher_map_form" model="ir.ui.view">
        <field name="name">tally.voucher.map.form</field>
        <field name="model">tally.voucher.map</field>
        <field name="arch" type="xml">
            <form string="Tally Voucher Type Mapping">
                <sheet>
                    <group>
                        <group string="Odoo Side">
                            <field name="move_type"/>
                        </group>
                        <group string="Tally Side">
                            <field name="tally_voucher_type" placeholder="e.g. Sales, Purchase, Credit Note"/>
                            <field name="tally_persistedview" placeholder="e.g. Invoice Voucher View"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tally_voucher_map" model="ir.actions.act_window">
        <field name="name">Tally Voucher Type Mapping</field>
        <field name="res_model">tally.voucher.map</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
