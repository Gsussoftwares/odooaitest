<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_tally_inherit" model="ir.ui.view">
        <field name="name">account.payment.form.tally.connector</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_post']" position="after">
                <button string="Sync to Tally"
                        name="action_sync_to_tally"
                        type="object"
                        class="btn-secondary"
                        invisible="not move_id or state not in ('in_process', 'paid')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_tally_logs"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        invisible="tally_sync_log_count == 0">
                    <field name="tally_sync_log_count" widget="statinfo" string="Tally Logs"/>
                </button>
            </xpath>
            <xpath expr="//notebook[@name='payment_notebook']" position="inside">
                <page string="Tally Sync" name="tally_payment_sync_page">
                    <group>
                        <field name="tally_sync_status" widget="badge" readonly="1"/>
                        <field name="tally_guid" readonly="1" invisible="not tally_guid"/>
                        <field name="tally_last_sync" readonly="1" invisible="not tally_last_sync"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
