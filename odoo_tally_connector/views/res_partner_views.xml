<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_tally_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.tally.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="tally_connector" string="Tally Sync" groups="account.group_account_manager">
                    <group>
                        <group string="Tally Integration Status">
                            <field name="tally_guid" readonly="1"/>
                            <field name="tally_last_sync" readonly="1"/>
                        </group>
                        <group string="Actions">
                            <button name="action_sync_to_tally" 
                                    string="Sync to Tally" 
                                    type="object" 
                                    class="btn-primary"
                                    icon="fa-refresh"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
