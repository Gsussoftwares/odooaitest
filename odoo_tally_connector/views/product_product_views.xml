<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_normal_form_view_tally_inherit" model="ir.ui.view">
        <field name="name">product.product.form.tally.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="tally_connector" string="Tally Sync" groups="account.group_account_manager">
                    <group>
                        <group string="Tally Integration Status">
                            <field name="tally_guid" readonly="1"/>
                            <field name="tally_last_sync" readonly="1"/>
                            <field name="tally_hsn_description" readonly="1"/>
                        </group>
                        <group string="Actions">
                            <button name="action_sync_to_tally" 
                                    string="Sync to Tally" 
                                    type="object" 
                                    class="btn-primary"
                                    icon="fa-refresh"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_tally_inherit" model="ir.ui.view">
        <field name="name">product.template.form.tally.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="tally_connector" string="Tally Sync" groups="account.group_account_manager">
                    <group>
                        <group string="Tally Integration Status">
                            <field name="tally_guid" readonly="1"/>
                            <field name="tally_last_sync" readonly="1"/>
                            <field name="tally_hsn_description" readonly="1"/>
                        </group>
                        <group string="Actions">
                            <button name="action_sync_to_tally" 
                                    string="Sync to Tally" 
                                    type="object" 
                                    class="btn-primary"
                                    icon="fa-refresh"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_batch_sync_tally_product_product" model="ir.actions.server">
        <field name="name">Sync to Tally</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                records.action_sync_to_tally()
        </field>
    </record>

    <record id="action_batch_sync_tally_product_template" model="ir.actions.server">
        <field name="name">Sync to Tally</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                records.action_sync_to_tally()
        </field>
    </record>

</odoo>
