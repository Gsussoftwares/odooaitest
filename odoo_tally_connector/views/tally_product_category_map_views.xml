<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tally_product_category_map_list" model="ir.ui.view">
        <field name="name">tally.product.category.map.list</field>
        <field name="model">tally.product.category.map</field>
        <field name="arch" type="xml">
            <list string="Tally Product Category Mapping" decoration-muted="not active">
                <field name="category_id"/>
                <field name="tally_stock_group_name"/>
                <field name="tally_parent_stock_group_name"/>
                <field name="active" widget="boolean" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_tally_product_category_map_form" model="ir.ui.view">
        <field name="name">tally.product.category.map.form</field>
        <field name="model">tally.product.category.map</field>
        <field name="arch" type="xml">
            <form string="Tally Product Category Mapping">
                <sheet>
                    <group>
                        <group string="Odoo Side">
                            <field name="category_id"/>
                        </group>
                        <group string="Tally Side">
                            <field name="tally_stock_group_name"/>
                            <field name="tally_parent_stock_group_name"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <button name="action_sync_to_tally_stock_group"
                            string="Sync Stock Group to Tally"
                            type="object"
                            class="btn-primary"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tally_product_category_map" model="ir.actions.act_window">
        <field name="name">Product Category Mapping</field>
        <field name="res_model">tally.product.category.map</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
