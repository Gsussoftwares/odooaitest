<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tally_hsn_description_map_list" model="ir.ui.view">
        <field name="name">tally.hsn.description.map.list</field>
        <field name="model">tally.hsn.description.map</field>
        <field name="arch" type="xml">
            <list string="HSN Description Mapping" decoration-muted="not active">
                <field name="hsn_code"/>
                <field name="tally_hsn_description"/>
                <field name="active" widget="boolean" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_tally_hsn_description_map_form" model="ir.ui.view">
        <field name="name">tally.hsn.description.map.form</field>
        <field name="model">tally.hsn.description.map</field>
        <field name="arch" type="xml">
            <form string="HSN Description Mapping">
                <sheet>
                    <group>
                        <group string="Odoo Side">
                            <field name="hsn_code" placeholder="e.g. 39259090"/>
                        </group>
                        <group string="Tally Side">
                            <field name="tally_hsn_description"
                                   placeholder="e.g. Plastic sheets / WPC boards"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tally_hsn_description_map" model="ir.actions.act_window">
        <field name="name">HSN Description Mapping</field>
        <field name="res_model">tally.hsn.description.map</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
