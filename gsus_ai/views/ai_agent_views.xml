<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Agent List View -->
    <record id="view_gsus_ai_agent_tree" model="ir.ui.view">
        <field name="name">gsus.ai.agent.list</field>
        <field name="model">gsus.ai.agent</field>
        <field name="arch" type="xml">
            <list string="Specialized AI Agents">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="role_description"/>
                <field name="provider_id"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Agent Kanban View -->
    <record id="view_gsus_ai_agent_kanban" model="ir.ui.view">
        <field name="name">gsus.ai.agent.kanban</field>
        <field name="model">gsus.ai.agent</field>
        <field name="arch" type="xml">
            <kanban string="AI Agents" class="o_gsus_ai_agent_kanban" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="role_description"/>
                <field name="skill_ids"/>
                <field name="is_default"/>
                <field name="is_active"/>
                <templates>
                    <t t-name="card" class="o_gsus_ai_agent_card d-flex flex-column justify-content-between p-3">
                        <div>
                            <div class="d-flex align-items-start gap-3 mb-2">
                                <div class="o_gsus_ai_agent_avatar rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width: 44px; height: 44px; min-width: 44px; min-height: 44px; background: rgba(124, 58, 237, 0.1); color: #7c3aed; font-weight: 700; font-size: 1.1rem; border: 1px solid rgba(124, 58, 237, 0.2); white-space: nowrap;">
                                    AI
                                </div>
                                <div class="flex-grow-1 min-w-0" style="min-width: 0;">
                                    <div class="d-flex align-items-center justify-content-between gap-2">
                                        <h5 class="mb-0 fw-bold text-truncate" style="color: #0f172a; font-size: 1.05rem;">
                                            <field name="name"/>
                                        </h5>
                                        <span t-if="record.is_default.raw_value" class="badge bg-primary-subtle text-primary border border-primary-subtle flex-shrink-0" style="font-size: 0.72rem; font-weight: 600;">
                                            Default
                                        </span>
                                    </div>
                                    <div class="text-muted small mt-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4; font-size: 0.83rem; min-height: 2.8em;">
                                        <field name="role_description"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top border-light">
                            <field name="skill_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Agent Form View -->
    <record id="view_gsus_ai_agent_form" model="ir.ui.view">
        <field name="name">gsus.ai.agent.form</field>
        <field name="model">gsus.ai.agent</field>
        <field name="arch" type="xml">
            <form string="Specialized AI Agent">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Odoo AI, Sales Copilot..."/>
                        </h1>
                    </div>
                    <group>
                        <group name="agent_info" string="Agent Persona">
                            <field name="code"/>
                            <field name="role_description" placeholder="Brief tagline of capabilities"/>
                            <field name="is_default"/>
                            <field name="is_active" widget="boolean_toggle"/>
                        </group>
                        <group name="provider_info" string="Model Configuration">
                            <field name="provider_id"/>
                            <field name="model_override" placeholder="Leave blank to use provider default"/>
                            <field name="temperature"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assigned Skills" name="skills">
                            <field name="skill_ids" widget="many2many_tags" placeholder="Select capability skills (e.g. Search Database, Create Records)..."/>
                        </page>
                        <page string="Direct Tools Override" name="tools">
                            <field name="tool_ids" widget="many2many_tags" placeholder="Add specific standalone tools..."/>
                        </page>
                        <page string="System Prompt" name="system_prompt">
                            <field name="system_prompt" placeholder="Define the role, tone, and operational boundaries of this agent..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_gsus_ai_agent" model="ir.actions.act_window">
        <field name="name">Agents</field>
        <field name="res_model">gsus.ai.agent</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create specialized AI agents tailored to Sales, Finance, Inventory, or Audit tasks.
            </p>
        </field>
    </record>
</odoo>
