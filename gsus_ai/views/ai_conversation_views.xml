<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Conversation List View -->
    <record id="view_gsus_ai_conversation_tree" model="ir.ui.view">
        <field name="name">gsus.ai.conversation.list</field>
        <field name="model">gsus.ai.conversation</field>
        <field name="arch" type="xml">
            <list string="Conversations">
                <field name="is_pinned" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="agent_id"/>
                <field name="provider_id"/>
                <field name="model_name"/>
                <field name="total_messages_count"/>
                <field name="total_tokens_count"/>
                <field name="user_id"/>
                <field name="write_date" string="Last Active"/>
            </list>
        </field>
    </record>

    <!-- Conversation Form View -->
    <record id="view_gsus_ai_conversation_form" model="ir.ui.view">
        <field name="name">gsus.ai.conversation.form</field>
        <field name="model">gsus.ai.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversation Session">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="is_pinned" widget="boolean_button" options="{'terminology': 'pinned'}"/>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Conversation Title..."/>
                        </h1>
                    </div>
                    <group>
                        <group name="meta_left">
                            <field name="agent_id"/>
                            <field name="provider_id"/>
                            <field name="model_name"/>
                        </group>
                        <group name="meta_right">
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="total_tokens_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Messages History" name="messages">
                            <field name="message_ids" readonly="1">
                                <list string="Messages" decoration-muted="role == 'system'" decoration-info="role == 'user'" decoration-success="role == 'assistant'">
                                    <field name="create_date" string="Time"/>
                                    <field name="role" widget="badge"/>
                                    <field name="content"/>
                                    <field name="token_count"/>
                                    <field name="duration_seconds" string="Duration (s)"/>
                                </list>
                            </field>
                        </page>
                        <page string="Action Proposals" name="proposals">
                            <field name="proposal_ids" readonly="1">
                                <list string="Proposals" decoration-warning="state == 'pending'" decoration-success="state == 'confirmed'" decoration-danger="state == 'rejected'">
                                    <field name="tool_id"/>
                                    <field name="summary"/>
                                    <field name="state" widget="badge"/>
                                    <field name="executed_by"/>
                                    <field name="executed_at"/>
                                </list>
                            </field>
                        </page>
                        <page string="System Prompt &amp; Instructions" name="system_prompt">
                            <field name="system_prompt" placeholder="Custom system instructions for this session..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Conversations -->
    <record id="action_gsus_ai_conversation" model="ir.actions.act_window">
        <field name="name">AI Conversations</field>
        <field name="res_model">gsus.ai.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Start your first conversational session with GSUS AI.
            </p>
        </field>
    </record>
</odoo>
