                <path d="M5.5 2.5C5.5 4.5 7 5.5 9 5.5C7 5.5 5.5 6.5 5.5 8.5C5.5 6.5 4 5.5 2 5.5C4 5.5 5.5 4.5 5.5 2.5Z" fill="url(#geminiSparkleGrad)"/>
