                role="menuitem">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="lai-gemini-sparkle me-1" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="geminiSparkleGrad" x1="0%" y1="0%" x2="100%" y2="100%">
