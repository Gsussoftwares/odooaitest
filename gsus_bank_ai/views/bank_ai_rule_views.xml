<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gsus_bank_ai_rule_tree" model="ir.ui.view">
        <field name="name">gsus.bank.ai.rule.tree</field>
        <field name="model">gsus.bank.ai.rule</field>
        <field name="arch" type="xml">
            <list string="AI Bank Statement Matching Rules" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="keyword"/>
                <field name="match_type"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <field name="learned_from_chat" readonly="1" widget="boolean_toggle"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_gsus_bank_ai_rule" model="ir.actions.act_window">
        <field name="name">AI Matching Rules</field>
        <field name="res_model">gsus.bank.ai.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
